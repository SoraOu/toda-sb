diff --git a/css/redesign.css b/css/redesign.css
new file mode 100644
index 0000000..c150a78
--- /dev/null
+++ b/css/redesign.css
@@ -0,0 +1,126 @@
+/* MTPFMS institutional redesign. Loaded after app.css; relies only on the theme variables in themes.css,
+   so every colour theme and light/dark mode keeps working. */
+:root{--hh:64px;--navw:248px;--navc:68px;--r:10px;--sh:0 1px 3px rgba(20,10,10,.10),0 1px 2px rgba(20,10,10,.06);--font:Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif}
+html[data-mode=dark]{--sh:0 1px 3px rgba(0,0,0,.5)}
+body,select,input,button,textarea{font-family:var(--font)}
+body{font-size:14px;-webkit-font-smoothing:antialiased}
+h1,h2,h3,.serif,legend,.card b,header b{font-family:var(--font)}
+h2{font-size:24px;font-weight:700;letter-spacing:-.01em}
+.panel,fieldset{border-radius:var(--r);box-shadow:var(--sh)}
+.btn{border-radius:8px;font-weight:500;display:inline-flex;align-items:center;gap:6px}
+.ic{flex:none;display:block}
+a:focus-visible,button:focus-visible,[role=button]:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}
+
+/* ---------- header ---------- */
+body>header{min-height:var(--hh);padding:8px 20px;gap:14px;border-bottom:3px solid var(--secondary);box-shadow:0 2px 6px rgba(0,0,0,.18);position:sticky;top:0;z-index:20}
+body>header b{font-size:16px;font-weight:700;letter-spacing:.2px;line-height:1.25}
+body>header small{font-size:12px;opacity:.88;margin-top:1px}
+body>header .logo{width:46px;height:46px;border-width:2px}
+#burger{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;padding:0;font-size:18px;border-radius:8px;cursor:pointer}
+#burger:hover,.hbtn:hover{background:rgba(255,255,255,.14)}
+#bk{gap:10px!important}
+.hbtn{position:relative;display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border:1px solid rgba(255,255,255,.35);border-radius:8px;background:none;color:inherit;cursor:pointer}
+.hbtn:disabled{cursor:default;opacity:.7}
+.hbadge{position:absolute;top:-6px;right:-6px;min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--secondary);color:#2b1400;font:700 11px/18px var(--font);text-align:center}
+.hprof{display:flex;align-items:center;gap:9px;padding:3px 10px 3px 3px;border-radius:999px;background:rgba(255,255,255,.12)}
+.hav{width:32px;height:32px;border-radius:50%;background:var(--secondary);color:#2b1400;display:flex;align-items:center;justify-content:center;font:700 12px var(--font)}
+.hpt{display:flex;flex-direction:column;line-height:1.2;max-width:170px}.hpt b{font-size:13px!important;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.hpt small{font-size:11px!important;margin:0}
+
+/* ---------- sidebar ---------- */
+.wrap{align-items:flex-start;min-height:calc(100vh - var(--hh))}
+nav{width:var(--navw);padding:10px 0 20px;position:sticky;top:var(--hh);height:calc(100vh - var(--hh));overflow-y:auto;overflow-x:hidden;border-right:0;transition:width .2s}
+.ng{padding:6px 10px 2px}.ng+.ng{border-top:1px solid color-mix(in srgb,var(--sidebar-text) 14%,transparent);margin-top:6px;padding-top:12px}
+.nh{font-size:10.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:0 10px 6px;color:color-mix(in srgb,var(--secondary) 80%,var(--sidebar-text))}
+nav a{display:flex;align-items:center;gap:11px;margin:1px 0;padding:9px 10px;border-left:0;border-radius:8px;font-size:13.5px;font-weight:500;position:relative;white-space:nowrap;outline-offset:-2px}
+nav a .ic{opacity:.85}
+nav a:hover{background:color-mix(in srgb,var(--sidebar-text) 12%,transparent)}
+nav a.on{background:var(--sidebar-active-background);color:var(--sidebar-active-text);font-weight:600;box-shadow:inset 3px 0 0 var(--secondary)}
+nav a.on .ic{color:var(--secondary);opacity:1}
+nav a:focus-visible{outline:2px solid var(--secondary)}
+body.nav-collapsed nav{width:var(--navc)}
+body.nav-collapsed nav a{justify-content:center;padding:10px 0}body.nav-collapsed nav a span{display:none}
+body.nav-collapsed .nh{font-size:0;padding:0;height:1px;margin:2px 14px 8px;background:color-mix(in srgb,var(--sidebar-text) 20%,transparent)}
+body.nav-collapsed nav a.on{box-shadow:none;outline:2px solid color-mix(in srgb,var(--secondary) 70%,transparent);outline-offset:-2px}
+main{padding:22px 26px;max-width:1500px}
+
+/* ---------- page header ---------- */
+.pghd{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:center;justify-content:space-between;margin-bottom:16px}
+.pghd h2{margin:0}.sub{margin:2px 0 0;color:var(--text-secondary);font-size:13px}.pghd .tools{margin:0}
+.note{border-radius:8px}
+
+/* ---------- KPI cards ---------- */
+.kpis{grid-template-columns:repeat(auto-fill,minmax(184px,1fr));gap:12px;margin-bottom:18px}
+.card.kpi{--tone:var(--primary);position:relative;display:flex;flex-direction:column;gap:2px;padding:14px 14px 12px;border:1px solid var(--border);border-left:1px solid var(--border);border-top:3px solid var(--tone);border-radius:var(--r);box-shadow:var(--sh);transition:box-shadow .15s,transform .15s,border-color .15s}
+.kpi.ok{--tone:var(--status-approved)}.kpi.bad{--tone:var(--status-overdue)}.kpi.warn{--tone:var(--status-pending)}.kpi.info{--tone:var(--status-in-progress)}
+.ki{position:absolute;top:11px;right:11px;width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--tone);background:color-mix(in srgb,var(--tone) 13%,transparent)}
+.ki .ic{width:16px;height:16px}
+.kl{font-size:12.5px;font-weight:600;color:var(--text-secondary);padding-right:36px;min-height:2.6em;line-height:1.3}
+.card.kpi b.kv{font:700 30px/1.15 var(--font);letter-spacing:-.02em;color:var(--text-primary);display:block;font-variant-numeric:tabular-nums}
+.kd{font-size:11.5px;color:var(--text-secondary)}
+.card.kpi.lk:hover,.card.kpi.lk:focus-visible{transform:translateY(-2px);box-shadow:0 6px 16px rgba(20,10,10,.16);border-color:var(--tone)}
+.card.kpi.lk:focus-visible{outline:2px solid var(--focus-ring);outline-offset:2px}
+
+/* ---------- sections and charts ---------- */
+.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;margin-bottom:14px}
+.two{gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));margin-bottom:14px}
+.grid3 .panel,.two .panel{margin-bottom:0}
+.sec{padding:16px 18px}
+.sh{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--border)}
+.sh h3{margin:0;font-size:14.5px;font-weight:600;display:flex;align-items:center;gap:8px;color:var(--text-primary)}
+.sh h3 .ic{color:var(--primary)}
+.cnt{font-size:11.5px;font-weight:600;padding:1px 8px;border-radius:999px;background:var(--primary-light);color:var(--primary)}
+.va{font-size:12.5px;font-weight:600;color:var(--primary);text-decoration:none;white-space:nowrap}.va:hover{text-decoration:underline}
+.dn{display:flex;flex-wrap:wrap;align-items:center;gap:14px 20px}
+.dn svg{width:148px;height:148px;flex:none;transform:rotate(0)}
+.dnt{font:700 8px var(--font);fill:var(--text-primary)}.dns{font:500 2.7px var(--font);fill:var(--text-secondary)}
+.lg{list-style:none;margin:0;padding:0;flex:1;min-width:150px}
+.lg li{display:grid;grid-template-columns:12px 1fr auto 38px;align-items:center;gap:8px;padding:4px 0;font-size:13px}
+.lg li i,.lg.inl i{width:10px;height:10px;border-radius:3px;display:inline-block}
+.lg li b{font-variant-numeric:tabular-nums}.lg li small{color:var(--text-secondary);text-align:right}
+.lg.inl{display:flex;gap:16px;margin-top:10px;font-size:12px;color:var(--text-secondary)}.lg.inl span{display:flex;align-items:center;gap:6px}
+.hbs{display:flex;flex-direction:column;gap:9px}
+.hb{display:grid;grid-template-columns:minmax(80px,120px) 1fr 38px;align-items:center;gap:10px;font-size:12.5px}
+.hb>span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--text-secondary)}
+.hb>b{text-align:right;font-variant-numeric:tabular-nums}
+.trk{height:11px;border-radius:6px;background:color-mix(in srgb,var(--text-secondary) 15%,transparent);overflow:hidden;display:flex}
+.trk i{display:block;height:100%;min-width:0;border-radius:0}
+.trk:not(.st) i{border-radius:6px}
+.scr{max-height:320px;overflow-y:auto;padding-right:6px}
+
+/* lists */
+.ls{list-style:none;margin:0;padding:0}
+.ls li{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 0;border-bottom:1px solid var(--border)}
+.ls li:last-child{border-bottom:0}
+.ls a{color:var(--primary);font-weight:600;cursor:pointer;text-decoration:none}.ls a:hover{text-decoration:underline}
+.ls small{display:block;color:var(--text-secondary);font-size:12px;margin-top:1px}
+.act2{font-size:13px}
+.tag{flex:none;font-size:11.5px;font-weight:600;padding:2px 9px;border-radius:999px;background:color-mix(in srgb,var(--text-secondary) 14%,transparent);color:var(--text-primary)}
+.tag.w{background:color-mix(in srgb,var(--status-pending) 18%,transparent);color:var(--status-pending)}
+.em{color:var(--text-secondary);margin:6px 0;font-size:13px}.more{color:var(--text-secondary);font-size:12px;margin:8px 0 0}
+.rm{display:grid;grid-template-columns:1fr 1fr;gap:10px}
+.rm div{border:1px solid var(--border);border-radius:8px;padding:10px 12px}
+.rm b{display:block;font-size:24px;font-weight:700;color:var(--primary);font-variant-numeric:tabular-nums}.rm span{font-size:12px;color:var(--text-secondary)}
+.sy{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);font-size:13px}
+.sy:last-child{border-bottom:0}.sy span{color:var(--text-secondary)}
+.sd{font-weight:600;display:inline-flex;align-items:center;gap:7px}
+.sd.ok::before,.sd.warn::before,.sd.bad::before{content:"";width:8px;height:8px;border-radius:50%;background:currentColor}
+.sd.ok{color:var(--status-approved)}.sd.warn{color:var(--status-pending)}.sd.bad{color:var(--status-overdue)}
+
+/* ---------- responsive ---------- */
+@media(max-width:1100px){main{padding:18px}}
+@media(max-width:760px){
+  :root{--hh:60px}
+  body>header{padding:8px 12px;gap:10px}
+  body>header b{font-size:13px}body>header small{display:none}
+  body>header .logo{width:38px;height:38px}
+  nav{position:fixed;top:var(--hh);bottom:0;left:-270px;width:260px;height:auto;z-index:25;transition:left .2s;box-shadow:4px 0 18px rgba(0,0,0,.3)}
+  nav.open{left:0}
+  body.nav-collapsed nav{width:260px}body.nav-collapsed nav a{justify-content:flex-start;padding:9px 10px}body.nav-collapsed nav a span{display:inline}
+  body.nav-collapsed .nh{font-size:10.5px;height:auto;margin:0;padding:0 10px 6px;background:none}
+  main{padding:14px 12px}.hpt{display:none}.hprof{padding:3px}
+  .kpis{grid-template-columns:repeat(2,1fr);gap:10px}
+  .card.kpi b.kv{font-size:26px}
+  .grid3,.two{grid-template-columns:1fr}
+}
+@media(max-width:420px){body>header b{font-size:12px}.kpis{gap:8px}.kd{display:none}}
+@media print{.hbtn,.hprof,#burger{display:none!important}}
